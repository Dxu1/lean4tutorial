{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "REVISE",
        "BLOCK"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "contract_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_id": {
            "type": "string"
          },
          "adequate": {
            "type": "boolean"
          },
          "assessment": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "contract_id",
          "adequate",
          "assessment"
        ]
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1200
      }
    },
    "nonblocking_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1200
      }
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "dimension_assessments": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dimension_id": {
                "type": "string",
                "enum": [
                  "D01",
                  "D05",
                  "D06",
                  "D07",
                  "D08",
                  "D12",
                  "D13",
                  "D14",
                  "D15",
                  "D16",
                  "D18",
                  "D19",
                  "D20"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS"
                ]
              },
              "refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "summary": {
                "type": "string",
                "minLength": 24,
                "maxLength": 240
              }
            },
            "required": [
              "dimension_id",
              "status",
              "refs",
              "summary"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dimension_id": {
                "type": "string",
                "enum": [
                  "D02",
                  "D03",
                  "D04",
                  "D09",
                  "D10",
                  "D11",
                  "D17"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS"
                ]
              },
              "refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "summary": {
                "type": "string",
                "minLength": 24,
                "maxLength": 400
              }
            },
            "required": [
              "dimension_id",
              "status",
              "refs",
              "summary"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dimension_id": {
                "type": "string",
                "enum": [
                  "D01",
                  "D02",
                  "D03",
                  "D04",
                  "D05",
                  "D06",
                  "D07",
                  "D08",
                  "D09",
                  "D10",
                  "D11",
                  "D12",
                  "D13",
                  "D14",
                  "D15",
                  "D16",
                  "D17",
                  "D18",
                  "D19",
                  "D20"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "FAIL",
                  "UNCERTAIN",
                  "NOT_APPLICABLE"
                ]
              },
              "refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "summary": {
                "type": "string",
                "minLength": 24,
                "maxLength": 1000
              }
            },
            "required": [
              "dimension_id",
              "status",
              "refs",
              "summary"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "gate_id",
    "attempt",
    "snapshot_sha256",
    "verdict",
    "confidence",
    "requires_human_review",
    "contract_assessments",
    "blocking_findings",
    "nonblocking_findings",
    "qualifications",
    "revision_prompt",
    "dimension_assessments"
  ]
}
