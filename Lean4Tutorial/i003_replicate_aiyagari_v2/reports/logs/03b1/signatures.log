def Aiyagari1994.extendedRightMarginalValue : Aiyagari1994.HouseholdPrimitives → Aiyagari1994.Resources → ENNReal :=
fun (m : Aiyagari1994.HouseholdPrimitives) (z : Aiyagari1994.Resources) =>
